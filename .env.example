# ---------------------------------------------------------------------------
# Housing Market Risk Dashboard - environment configuration
#
# Copy this file to `.env` and fill in the values you have:
#     cp .env.example .env
#
# Vite only exposes variables prefixed with `VITE_` to browser code. Because
# this app has no backend, ANY key you put here is compiled into the JavaScript
# bundle and is readable by anyone who loads the page. That is acceptable for
# these particular keys -- Census, BLS and FRED keys are free, read-only,
# rate-limit identifiers, not secrets that grant access to private data. Do not
# put a key with real privileges in a client-side app.
#
# The app also lets you paste keys into the Settings panel at runtime, which
# stores them in your browser's localStorage instead of baking them into the
# bundle. That is the better option if you plan to deploy the built site.
# ---------------------------------------------------------------------------

# --- Census Bureau API -------------------------------------------------------
# REQUIRED. As of 2025 the Census API rejects every request without a key.
# Free, instant, no approval step: https://api.census.gov/data/key_signup.html
# Rate limit: no published hard cap for keyed requests, but be polite -- this
# app batches and caches aggressively so a full dashboard load is ~4 calls.
VITE_CENSUS_API_KEY=

# --- Bureau of Labor Statistics API -----------------------------------------
# OPTIONAL but strongly recommended.
#   Without a key (v1 API): 25 requests/day, 10 years max, no net/calculations.
#   With a key   (v2 API): 500 requests/day, 20 years, series descriptions.
# Free registration: https://data.bls.gov/registrationEngine/
VITE_BLS_API_KEY=

# --- FRED (St. Louis Fed) ----------------------------------------------------
# OPTIONAL. The app reads FRED through its keyless CSV chart endpoint
# (fredgraph.csv), so no key is needed for the default configuration. Supply a
# key only if you switch VITE_FRED_MODE to "api" below.
# Free key: https://fredaccount.stlouisfed.org/apikeys
VITE_FRED_API_KEY=
# "csv"  -> keyless https://fred.stlouisfed.org/graph/fredgraph.csv (default)
# "api"  -> https://api.stlouisfed.org/fred/... (requires VITE_FRED_API_KEY;
#            note this host historically does NOT send CORS headers)
VITE_FRED_MODE=csv

# --- CORS handling -----------------------------------------------------------
# Several hosts below answer requests fine but omit Access-Control-Allow-Origin,
# so the browser discards the response. Options:
#
#   false (default) -> pure client-side. Blocked sources degrade gracefully and
#                      offer a drag-and-drop file upload instead.
#   true            -> route those sources through Vite's dev-server proxy
#                      (see vite.config.js). Local development only.
VITE_USE_DEV_PROXY=false

# Optional: your own CORS proxy, used if the direct request fails and the dev
# proxy is off. The target URL is appended, URL-encoded. Leave blank to disable.
# Example: VITE_CORS_PROXY=https://my-worker.example.workers.dev/?url=
VITE_CORS_PROXY=

# --- Data window -------------------------------------------------------------
# How many years of history to request. Keep <= 20; BLS v2 caps at 20 years per
# request and larger windows mean slower in-browser parsing of the Redfin files.
VITE_HISTORY_YEARS=12

# --- Caching -----------------------------------------------------------------
# Minutes to keep a successful response in localStorage before refetching.
# These datasets update monthly at best, so a long TTL costs you nothing and
# keeps you comfortably inside every rate limit.
VITE_CACHE_TTL_MINUTES=720
